# ─────────────────────────────────────────────────────────────
# Atelier — environment variables
# Copy to .env and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development                     # development | test | production
APP_URL=http://localhost:3000            # Public base URL (used in emails, OAuth & payment callbacks)
LOG_LEVEL=info                           # fatal | error | warn | info | debug | trace

# Database (PostgreSQL). Use a least-privilege role in production (see docs/DEPLOYMENT.md).
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public
DATABASE_POOL_MAX=10                     # Max pooled connections per app instance

# Redis (caching + rate limiting). Optional: falls back to in-process behaviour.
REDIS_URL=redis://localhost:6379

# Security — generate each with: openssl rand -base64 48
AUTH_SECRET=                             # HMAC signing (upload tokens, callbacks). >= 32 chars
ENCRYPTION_KEY=                          # AES-256-GCM key material for MFA secrets. >= 32 chars
SESSION_TTL_DAYS=30                      # Customer session lifetime
ADMIN_SESSION_TTL_HOURS=12               # Staff session lifetime
ADMIN_MFA_REQUIRED=true                  # Require TOTP MFA for all staff (keep true in production)

# Google OAuth (optional). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Commerce
STORE_CURRENCY=KES                       # ISO 4217 currency for prices (KES = Kenyan shilling)
TAX_RATE_BPS=1600                        # Tax rate in basis points (1600 = 16% VAT)
TAX_INCLUSIVE=false                      # true if catalogue prices already include tax

# Storage: "local" (disk) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=                             # R2: https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                           # Public bucket/custom domain base URL
CDN_URL=                                 # Optional CDN in front of uploaded assets
CLOUDINARY_CLOUD_NAME=                   # Optional: enables Cloudinary fetch transformations for images

# Email (SMTP). If unset, emails are written to the log instead of being sent.
SMTP_URL=                                # e.g. smtps://user:pass@smtp.example.com:465
EMAIL_FROM="Atelier <no-reply@atelier.example>"

# Payments ────────────────────────────────────────────────────
# Sandbox provider (development/testing only — refused when NODE_ENV=production)
PAYMENT_SANDBOX_ENABLED=false
SANDBOX_WEBHOOK_SECRET=

# Card payments (Stripe Checkout). Webhook: ${APP_URL}/api/webhooks/card
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa (Safaricom Daraja STK Push). Callback is generated per payment.
MPESA_ENV=sandbox                        # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=                   # >= 32 chars, signs callback URLs
MPESA_KES_RATE=                          # Required when STORE_CURRENCY != KES (1 unit = N KES)

# PayPal (Orders v2). Webhook: ${APP_URL}/api/webhooks/paypal
PAYPAL_ENV=sandbox                       # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Background jobs: secret for the HTTP job-runner endpoint (/api/cron/jobs) used on serverless hosts
CRON_SECRET=

# Testing only: scales all rate limits (all e2e traffic comes from one IP). Never set in production.
RATE_LIMIT_MULTIPLIER=1

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Seeding (development only)
SEED_ADMIN_EMAIL=admin@atelier.local
SEED_ADMIN_PASSWORD=Atelier-Admin-2026
