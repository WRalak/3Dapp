// Mtindo — Kenyan 3D fashion marketplace (multi-vendor)
// Monetary values are stored as exact integer minor units (KES cents). Never floats.
// Per-transaction amounts use Int; cumulative wallet balances use BigInt.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity, sessions & access control
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  emailVerifiedAt  DateTime?
  phone            String?    @unique
  phoneVerifiedAt  DateTime?
  locale           String     @default("en-KE")
  passwordHash     String?
  name             String?
  image            String?
  status           UserStatus @default(ACTIVE)
  isStaff          Boolean    @default(false)
  mfaEnabled       Boolean    @default(false)
  mfaSecret        String? // AES-256-GCM encrypted TOTP secret
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  accounts           Account[]
  sessions           Session[]
  tokens             VerificationToken[]
  roles              UserRole[]           @relation("UserRoles")
  rolesAssigned      UserRole[]           @relation("RoleAssigner")
  permissions        UserPermission[]
  profile            CustomerProfile?
  addresses          Address[]
  cart               Cart?
  wishlist           Wishlist?
  orders             Order[]
  reviews            Review[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  invitationsSent    AdminInvitation[]
  statusChanges      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  refunds            Refund[]
  models3D           ProductModel3D[]
  restockAlerts      RestockSubscription[]
  couponRedemptions  CouponRedemption[]
  seller             Seller?              @relation("SellerOwner")
  sellerReviews      SellerVerification[] @relation("SellerReviewer")
  follows            SellerFollow[]
  inquiries          SellerInquiry[]
  inquiryMessages    InquiryMessage[]
  productReports     ProductReport[]      @relation("Reporter")
  phoneVerifications PhoneVerification[]
  payoutsProcessed   SellerPayout[]       @relation("PayoutProcessor")

  @@index([status])
  @@index([isStaff])
  @@index([createdAt])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  mfaVerified Boolean   @default(false)
  ip          String?
  userAgent   String?
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  group       String
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Direct permission grants on top of role permissions (SUPER_ADMIN managed).
model UserPermission {
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model AdminInvitation {
  id          String    @id @default(cuid())
  email       String
  roleIds     String[]
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────

model CustomerProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  phone               String?
  dateOfBirth         DateTime?
  notifyOrderUpdates  Boolean   @default(true)
  notifyPromotions    Boolean   @default(false)
  notifyRestock       Boolean   @default(true)
  notifyDelivery      Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String    @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String    @db.Char(2)
  // Kenyan delivery detail (county → town → estate/neighbourhood → building → directions)
  countyId   String?
  town       String?
  estate     String?
  building   String?
  directions String?
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  county     County?   @relation(fields: [countyId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  isFeatured  Boolean   @default(false)
  sellerId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  seller      Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([sellerId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  // Optional commission override in basis points (seller override > category > platform default)
  commissionRateBps Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum GarmentKind {
  TOP
  SHIRT
  JACKET
  COAT
  DRESS
  TROUSERS
  SKIRT
  KNIT
  SHOES
  BAG
  ACCESSORY
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  description       String
  brandId           String
  categoryId        String
  sellerId          String
  status            ProductStatus @default(DRAFT)
  approvalStatus    ApprovalStatus @default(PENDING_REVIEW)
  rejectionReason   String?
  reviewedAt        DateTime?
  isFeatured        Boolean       @default(false)
  garmentKind       GarmentKind   @default(TOP)
  priceCents        Int
  salePriceCents    Int?
  saleEndsAt        DateTime?
  material          String?
  fabricComposition String?
  careInstructions  String?
  measurements      Json? // { "S": { "chest": 96, "length": 70 }, ... } in cm
  specifications    Json? // [{ label, value }]
  tags              String[]
  seoTitle          String?
  seoDescription    String?
  ratingAvg         Float         @default(0)
  ratingCount       Int           @default(0)
  salesCount        Int           @default(0)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  seller        Seller                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  reports       ProductReport[]
  inquiries     SellerInquiry[]
  brand         Brand                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  model3D       ProductModel3D?
  collections   CollectionProduct[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([status, deletedAt])
  @@index([sellerId, status])
  @@index([approvalStatus])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([salesCount])
  @@index([priceCents])
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  sku            String    @unique
  size           String
  color          String
  colorHex       String    @db.VarChar(7)
  priceCents     Int? // overrides product price when set
  salePriceCents Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  restockAlerts RestockSubscription[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([color])
  @@index([size])
}

enum ImageKind {
  GALLERY
  FRONT
  BACK
  SIDE
  FABRIC_DETAIL
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  alt       String
  kind      ImageKind @default(GALLERY)
  color     String?
  sortOrder Int       @default(0)
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// ACCURATE: scanned/modelled from the real garment, textures may be inspected.
/// ILLUSTRATIVE: generic silhouette only — the UI must not imply fabric accuracy.
enum ModelRepresentation {
  ACCURATE
  ILLUSTRATIVE
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  REJECTED
}

model ProductModel3D {
  id            String      @id @default(cuid())
  productId     String?     @unique
  name          String
  fileKey       String      @unique
  url           String
  format        String // glb | gltf
  fileSize      Int         @default(0)
  status        AssetStatus @default(UPLOADING)
  representation ModelRepresentation @default(ACCURATE)
  hasDraco      Boolean     @default(false)
  hasKtx2       Boolean     @default(false)
  hasMeshopt    Boolean     @default(false)
  triangleCount Int?
  meshCount     Int?
  materialCount Int?
  textureCount  Int?
  textureInfo   Json?
  boundingBox   Json?
  compatibility Json? // { score, issues: [{ level, message }] }
  errorMessage  String?
  uploadedById  String?
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([status])
}

model Collection {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  heroImageUrl String?
  sellerId     String?
  isCampaign   Boolean             @default(false)
  isFeatured   Boolean             @default(false)
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  products     CollectionProduct[]
  seller       Seller?             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────

model Inventory {
  id                String              @id @default(cuid())
  variantId         String              @unique
  quantity          Int                 @default(0) // on hand
  reserved          Int                 @default(0) // held by unpaid orders
  lowStockThreshold Int                 @default(5)
  updatedAt         DateTime            @updatedAt
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]
}

enum MovementType {
  RESTOCK
  ADJUSTMENT
  SALE
  RETURN
  RESERVATION
  RELEASE
}

model InventoryMovement {
  id          String       @id @default(cuid())
  inventoryId String
  type        MovementType
  quantity    Int // signed delta applied to `quantity` (or `reserved` for RESERVATION/RELEASE)
  balance     Int // on-hand quantity after the movement
  reason      String?
  referenceId String?
  actorId     String?
  createdAt   DateTime     @default(now())
  inventory   Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([type, createdAt])
}

model RestockSubscription {
  id         String         @id @default(cuid())
  userId     String
  variantId  String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

// ─────────────────────────────────────────────────────────────
// Cart & wishlist
// ─────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique // hash of guest cart cookie
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// ─────────────────────────────────────────────────────────────
// Orders, payments & fulfilment
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id                   String        @id @default(cuid())
  number               String        @unique
  userId               String?
  email                String
  customerName         String
  phone                String?
  status               OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus @default(UNPAID)
  currency             String        @db.Char(3)
  subtotalCents        Int
  discountCents        Int           @default(0)
  shippingCents        Int           @default(0)
  taxCents             Int           @default(0)
  totalCents           Int
  couponCode           String?
  shippingMethod       String
  shippingAddress      Json
  countyId             String?
  notes                String?
  idempotencyKey       String        @unique
  reservationExpiresAt DateTime?
  placedAt             DateTime      @default(now())
  paidAt               DateTime?
  cancelledAt          DateTime?
  updatedAt            DateTime      @updatedAt

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  refunds       Refund[]
  shipments     Shipment[]
  redemption    CouponRedemption?
  sellerOrders  SellerOrder[]
  ledger        PlatformTransaction[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([email])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  sellerOrderId  String?
  sellerId       String?
  productId      String?
  variantId      String?
  productName    String
  variantLabel   String
  sku            String
  imageUrl       String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder    SellerOrder?    @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([sellerId])
  @@index([productId])
}

/// Append-only. UPDATE/DELETE are blocked by a database trigger (see migrations).
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  MPESA
  CARD
  PAYPAL
  SANDBOX
}

enum PaymentState {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  status            PaymentState    @default(PENDING)
  amountCents       Int
  currency          String          @db.Char(3)
  providerReference String?
  idempotencyKey    String          @unique
  redirectUrl       String?
  failureReason     String?
  metadata          Json?
  succeededAt       DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  transactions      PaymentTransaction[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status, createdAt])
}

/// Every inbound webhook is recorded; (provider, eventId) uniqueness gives idempotency.
model PaymentEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  eventId        String
  type           String
  signatureValid Boolean
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  orderId           String
  sellerOrderId     String?
  amountCents       Int
  reason            String
  status            RefundStatus @default(PENDING)
  providerReference String?
  failureReason     String?
  actorId           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor             User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  sellerOrderId  String?
  provider       String         @default("manual") // shipping-provider adapter key
  carrier        String
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder    SellerOrder?   @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  tracking       ShipmentTracking[]

  @@index([orderId])
  @@index([sellerOrderId])
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             CouponType
  value            Int // percent (0-100) or minor units
  minSubtotalCents Int                @default(0)
  maxRedemptions   Int?
  redemptionCount  Int                @default(0)
  perUserLimit     Int?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
}

// ─────────────────────────────────────────────────────────────
// Engagement & content
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String
  rating           Int
  title            String
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
}

enum NotificationType {
  ORDER_UPDATE
  DELIVERY
  PROMOTION
  RESTOCK
  SYSTEM
  SELLER
  INQUIRY
  PAYOUT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Append-only. UPDATE/DELETE are blocked by a database trigger (see migrations).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum SubscriberStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(SUBSCRIBED)
  source           String?
  unsubscribeToken String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum ContentType {
  HERO
  BANNER
  PROMOTION
  EDITORIAL
  TESTIMONIAL
}

model ContentBlock {
  id        String      @id @default(cuid())
  type      ContentType
  placement String // e.g. home.hero, home.promo, home.editorial
  title     String
  subtitle  String?
  body      String?
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  data      Json?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([placement, isActive, sortOrder])
}

enum NavLocation {
  HEADER
  FOOTER
}

model NavigationLink {
  id        String      @id @default(cuid())
  label     String
  href      String
  location  NavLocation
  group     String?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, isActive, sortOrder])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Analytics & background processing
// ─────────────────────────────────────────────────────────────

enum AnalyticsEventType {
  SESSION_START
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  ORDER_PLACED
  SHOWROOM_INSPECT
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  visitorId String
  userId    String?
  productId String?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([productId, type])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
}

// ─────────────────────────────────────────────────────────────
// Marketplace: sellers
// ─────────────────────────────────────────────────────────────

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerBusinessType {
  DESIGNER
  BOUTIQUE
  BRAND
  MANUFACTURER
  RETAILER
}

model Seller {
  id                String             @id @default(cuid())
  ownerId           String             @unique
  slug              String             @unique
  businessName      String
  businessType      SellerBusinessType @default(DESIGNER)
  status            SellerStatus       @default(PENDING)
  countyId          String?
  town              String?
  isFeatured        Boolean            @default(false)
  /// Optional per-seller commission override in basis points (1000 = 10%).
  commissionRateBps Int?
  followerCount     Int                @default(0)
  ratingAvg         Float              @default(0)
  approvedAt        DateTime?
  suspendedAt       DateTime?
  rejectionReason   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  owner         User                 @relation("SellerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  county        County?              @relation(fields: [countyId], references: [id], onDelete: SetNull)
  profile       SellerProfile?
  documents     SellerDocument[]
  verifications SellerVerification[]
  products      Product[]
  brands        Brand[]
  collections   Collection[]
  zones         DeliveryZone[]
  sellerOrders  SellerOrder[]
  wallet        SellerWallet?
  payouts       SellerPayout[]
  commissions   Commission[]
  ledger        PlatformTransaction[]
  followers     SellerFollow[]
  inquiries     SellerInquiry[]

  @@index([status])
  @@index([countyId])
  @@index([isFeatured])
}

model SellerProfile {
  id                 String   @id @default(cuid())
  sellerId           String   @unique
  contactName        String
  email              String
  phone              String
  description        String
  logoUrl            String?
  coverUrl           String?
  website            String?
  instagram          String?
  categories         String[] // category slugs the seller trades in
  registrationNumber String? // optional business registration (BRS)
  kraPin             String?
  returnPolicy       String?
  // Payout destination (account numbers are AES-GCM encrypted at rest)
  payoutMethod       PayoutMethod @default(MPESA)
  payoutMpesaPhone   String?
  payoutBankName     String?
  payoutAccountName  String?
  payoutAccountNumberEnc String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

enum SellerDocumentType {
  BUSINESS_REGISTRATION
  KRA_PIN
  NATIONAL_ID
  OTHER
}

enum DocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Private files — never served from public storage paths.
model SellerDocument {
  id          String             @id @default(cuid())
  sellerId    String
  type        SellerDocumentType
  fileKey     String             @unique
  fileName    String
  contentType String
  size        Int
  status      DocumentStatus     @default(PENDING)
  note        String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  seller      Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

enum VerificationDecision {
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
  REACTIVATED
}

/// Append-only history of seller review decisions.
model SellerVerification {
  id         String               @id @default(cuid())
  sellerId   String
  decision   VerificationDecision
  notes      String?
  reviewerId String?
  createdAt  DateTime             @default(now())
  seller     Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer   User?                @relation("SellerReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
}

model SellerFollow {
  userId    String
  sellerId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([userId, sellerId])
  @@index([sellerId])
}

enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SellerInquiry {
  id         String           @id @default(cuid())
  sellerId   String
  customerId String
  productId  String?
  subject    String
  status     InquiryStatus    @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  seller     Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customer   User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages   InquiryMessage[]

  @@index([sellerId, status])
  @@index([customerId])
}

model InquiryMessage {
  id        String        @id @default(cuid())
  inquiryId String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  inquiry   SellerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ProductReport {
  id         String       @id @default(cuid())
  productId  String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

/// Automatic campaign discounts, scoped to sellers and/or categories.
model Promotion {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?
  type        PromotionType
  value       Int // percent or KES cents per unit
  sellerIds   String[]
  categoryIds String[]
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// Delivery
// ─────────────────────────────────────────────────────────────

model County {
  id        String         @id @default(cuid())
  code      Int            @unique // official county code 1–47
  name      String         @unique
  slug      String         @unique
  country   String         @default("KE") @db.Char(2)
  isActive  Boolean        @default(true)
  addresses Address[]
  sellers   Seller[]
  zones     DeliveryZoneCounty[]
}

/// A seller-defined area they deliver to (counties, optionally narrowed to towns).
model DeliveryZone {
  id        String               @id @default(cuid())
  sellerId  String
  name      String
  towns     String[] // empty = whole counties
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  seller    Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  counties  DeliveryZoneCounty[]
  methods   ShippingMethod[]

  @@index([sellerId])
}

model DeliveryZoneCounty {
  zoneId   String
  countyId String
  zone     DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  county   County       @relation(fields: [countyId], references: [id], onDelete: Cascade)

  @@id([zoneId, countyId])
  @@index([countyId])
}

enum DeliveryType {
  SAME_DAY
  NEXT_DAY
  STANDARD
  COURIER
  PICKUP
  SELLER_ARRANGED
}

model ShippingMethod {
  id            String       @id @default(cuid())
  zoneId        String
  type          DeliveryType
  name          String
  priceCents    Int
  freeOverCents Int?
  minDays       Int          @default(0)
  maxDays       Int          @default(3)
  /// Orders after this hour (EAT, 0–23) roll to the next day for SAME_DAY.
  cutoffHour    Int?
  /// Shipping-provider adapter key (e.g. "manual", a courier integration).
  provider      String       @default("manual")
  pickupAddress String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  zone          DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sellerOrders  SellerOrder[]

  @@index([zoneId])
}

/// One seller's portion of a customer order — fulfilled, shipped and settled independently.
model SellerOrder {
  id                 String        @id @default(cuid())
  orderId            String
  sellerId           String
  status             OrderStatus   @default(PENDING_PAYMENT)
  subtotalCents      Int
  discountCents      Int           @default(0) // seller-funded (promotions)
  shippingCents      Int           @default(0)
  totalCents         Int
  commissionCents    Int           @default(0)
  sellerNetCents     Int           @default(0)
  shippingMethodId   String?
  shippingMethodName String
  deliveryType       DeliveryType  @default(STANDARD)
  etaMinDays         Int           @default(0)
  etaMaxDays         Int           @default(3)
  shippedAt          DateTime?
  deliveredAt        DateTime?
  earningsReleasedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller             Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  shippingMethod     ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  shipments          Shipment[]
  commission         Commission?

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@index([status, createdAt])
}

model ShipmentTracking {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// ─────────────────────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────────────────────

enum PaymentTxnType {
  INITIATE
  CALLBACK
  STATUS_QUERY
  C2B_VALIDATION
  C2B_CONFIRMATION
  CAPTURE
  REFUND
}

/// Every interaction with a payment provider (requests, callbacks, receipts).
model PaymentTransaction {
  id                String         @id @default(cuid())
  paymentId         String?
  provider          PaymentProvider
  type              PaymentTxnType
  status            String
  providerReference String?
  receipt           String? // e.g. M-Pesa receipt (TransID)
  phone             String?
  amountCents       Int?
  raw               Json?
  createdAt         DateTime       @default(now())
  payment           Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, type, receipt])
  @@index([paymentId])
  @@index([providerReference])
}

enum CommissionStatus {
  ACCRUED
  PARTIALLY_REVERSED
  REVERSED
}

model Commission {
  id            String           @id @default(cuid())
  sellerOrderId String           @unique
  sellerId      String
  rateBps       Int
  baseCents     Int
  amountCents   Int
  reversedCents Int              @default(0)
  status        CommissionStatus @default(ACCRUED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sellerOrder   SellerOrder      @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  seller        Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
}

/// Derived balances; only ever changed in the same transaction as a ledger entry.
model SellerWallet {
  id                String   @id @default(cuid())
  sellerId          String   @unique
  pendingCents      BigInt   @default(0) // earned, not yet released (awaiting delivery + hold)
  availableCents    BigInt   @default(0) // withdrawable
  reservedCents     BigInt   @default(0) // requested payouts not yet completed
  lifetimeNetCents  BigInt   @default(0)
  paidOutCents      BigInt   @default(0)
  updatedAt         DateTime @updatedAt
  seller            Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

enum PayoutMethod {
  MPESA
  BANK_TRANSFER
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model SellerPayout {
  id            String       @id @default(cuid())
  sellerId      String
  amountCents   Int
  method        PayoutMethod
  destination   String // masked snapshot, e.g. 2547•••••678
  status        PayoutStatus @default(REQUESTED)
  /// Payout-provider adapter (manual today; mpesa-b2c once approved by Safaricom).
  provider      String       @default("manual")
  reference     String?
  failureReason String?
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  processedById String?
  seller        Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  processedBy   User?        @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  ledger        PlatformTransaction[]

  @@index([sellerId, status])
  @@index([status, requestedAt])
}

enum LedgerEntryType {
  ORDER_PAYMENT // customer money received by the platform
  SELLER_EARNING // seller's net credited to pending
  COMMISSION // platform revenue
  EARNING_RELEASE // pending → available
  REFUND // money returned to the customer
  SELLER_DEBIT // seller share clawed back on refund
  COMMISSION_REVERSAL
  PAYOUT // available → paid out to seller
  PAYOUT_REVERSAL
  ADJUSTMENT
}

/// Append-only double-entry style ledger of every money movement (trigger-protected).
model PlatformTransaction {
  id          String          @id @default(cuid())
  type        LedgerEntryType
  amountCents Int // positive = credit to the named account
  account     String // PLATFORM_CASH | PLATFORM_REVENUE | SELLER_PENDING | SELLER_AVAILABLE | SELLER_PAID | CUSTOMER_REFUNDS
  currency    String          @default("KES") @db.Char(3)
  sellerId    String?
  orderId     String?
  sellerOrderId String?
  payoutId    String?
  refundId    String?
  description String
  actorId     String?
  createdAt   DateTime        @default(now())
  seller      Seller?         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payout      SellerPayout?   @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
}
